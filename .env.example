# Copy this file to ".env" and fill in real values, then restart the server.
# Without SMTP_* set, the backend runs in DEV mode: form submissions are logged
# to the console instead of emailed (handy for local testing).

# Port the Express backend listens on (frontend dev proxy points here).
# 3002 so this runs alongside the original AP Digital backend (3001).
PORT=3002

# --- Proxy / security (optional) ----------------------------------------------
# How many reverse-proxy hops to trust for the client IP (rate limiting).
# Defaults: 1 in production (Render/Railway/etc. sit one proxy in front),
# 0 in dev. Set TRUST_PROXY=0 if you expose the server directly in production.
# IMPORTANT: this MUST match your real deployment. Too high and a client can
# spoof X-Forwarded-For to dodge the rate limit; too low and every visitor
# shares one IP and trips it. Confirm it for your host.
#TRUST_PROXY=1
# Extra origin allowed to call the API cross-site (rarely needed — the site
# itself is served same-origin). Example: https://www.yourdomain.com
#ALLOWED_ORIGIN=
# Site-wide hourly cap on contact submissions across ALL IPs — a backstop
# against IP-rotating spam floods that defeat the per-IP limit (5/hr). Default 50.
#MAX_GLOBAL=50

# --- SMTP (email delivery) ---------------------------------------------------
# Works with any provider: Gmail (use an App Password), Outlook, Zoho, SendGrid,
# Mailgun, your host's mailbox, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587/25
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# --- Addresses ---------------------------------------------------------------
# Where contact-form submissions are delivered (your inbox).
CONTACT_TO=hello@apdigital.com
# The "From" address shown on the email (often must match the SMTP account/domain).
CONTACT_FROM=no-reply@apdigital.com

# --- Anti-spam: Cloudflare Turnstile (optional, free) ------------------------
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both blank to disable the CAPTCHA (the form still works with the
# honeypot + rate limit). The site key is public; the secret key is private.
# Frontend needs the VITE_ prefix and a rebuild to pick it up.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Fail CLOSED when Cloudflare can't be reached (or a token is missing): set to
# true in production so an outage can't be used to bypass the CAPTCHA. Left unset
# it fails open (a CF outage won't drop real leads). Only meaningful once
# TURNSTILE_SECRET is set.
#TURNSTILE_REQUIRED=true
